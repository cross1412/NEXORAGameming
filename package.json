    "admin:promote:hosted": "node --env-file=.env.production scripts/promote-admin.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
