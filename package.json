    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "framer-motion": "^14.14.0",
    "helmet": "^8.3.0",
    "howler": "^2.2.4",
    "lucide-react": "latest",
    "mysql2": "^3.24.6",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "xss-clean": "^0.1.4"
  }
